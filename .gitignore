# Build output
/target/
**/target/
/target-*/
/dist/
/node_modules/
/frontend/node_modules/
/frontend/dist/

# Upstream clone and downloaded reference material (never committed)
/upstream/
/upstream-docs/

# Machine-specific Cargo configuration (the committed one is
# `Cargo.toml`; a local `.cargo/config.toml` overrides toolchain paths)
/.cargo/

# Generated data that upstream regenerates
/crates/tc-i18n/src/strings.generated.rs
/crates/tc-core/src/data/*.generated.rs

# Tauri's generated capability schemas (regenerated by tauri-build)
/apps/yal/gen/

# Models and large binaries
/models/
*.onnx

# Secrets
*.key
*.pem
.env
.env.*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
