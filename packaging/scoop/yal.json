{
    "version": "{{VERSION}}",
    "description": "YAL — a fast, pure-Rust Win32 + Direct2D keyboard launcher for Windows",
    "homepage": "https://github.com/{{REPOSITORY}}",
    "license": "AGPL-3.0-only",
    "checkver": {
        "url": "https://github.com/{{REPOSITORY}}/releases/latest",
        "regex": "releases/download/v(?<version>\\d+\\.\\d+\\.\\d+)"
    },
    "bin": [
        "yal"
    ],
    "url": "https://github.com/{{REPOSITORY}}/releases/download/v{{VERSION}}/yal-{{VERSION}}-x64-portable.zip",
    "hash": "{{PORTABLE_SHA256_X64}}",
    "home": "yal-{{VERSION}}-x64-portable",
    "env_add_path": [
        [".", "."]
    ]
}
