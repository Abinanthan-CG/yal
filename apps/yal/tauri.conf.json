{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YAL",
  "version": "0.1.0",
  "identifier": "dev.yal.launcher",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "palette",
        "title": "YAL",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "width": 720,
        "height": 460,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}